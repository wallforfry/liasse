# Liasse configuration. Copy to `.env` for local development.
# The schema in packages/core/src/config is the source of truth; a test keeps this file in sync.
# Commented variables show their default (or an example when they have none).

# --- Server -----------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8080

# --- Database (required) ----------------------------------------------------
# Postgres 16+ with pgvector 0.8+. This value matches docker-compose.dev.yml.
DATABASE_URL=postgres://liasse:liasse@127.0.0.1:54329/liasse

# --- File storage -----------------------------------------------------------
# STORAGE_DRIVER: fs | s3
# STORAGE_DRIVER=fs
STORAGE_PATH=./data/files
# S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are required when STORAGE_DRIVER=s3.
# S3_BUCKET=liasse
# S3_REGION defaults to us-east-1.
# S3_REGION=eu-west-3
# Set S3_ENDPOINT for any S3-compatible server; objects are then addressed path-style.
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Deadline of one S3 request. An upload gets this plus its size at S3_MIN_UPLOAD_RATE
# (bytes per second), so a large file on a slow link is not cut short.
# S3_REQUEST_TIMEOUT=30s
# S3_MIN_UPLOAD_RATE=65536

# Watched folder; ingestion from disk is disabled when empty. Liasse only reads it. A file
# is read once it held still for two seconds: a writer that pauses longer mid-file gets a
# partial document, so prefer tools that write under a temporary name and rename.
# WATCH_DIR=
# Largest accepted file, in bytes (50 MB by default).
# MAX_FILE_SIZE=52428800

# --- Language and vision models ---------------------------------------------
# LLM_PROVIDER: anthropic | openai | mistral | gemini | ollama | openai-compatible
LLM_PROVIDER=ollama
# LLM_API_KEY is required for anthropic, openai, mistral and gemini.
# LLM_API_KEY=
# LLM_BASE_URL is required for openai-compatible (the URL that ends in /v1). For ollama it
# is the server root and defaults to http://127.0.0.1:11434.
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# Both models are required.
VISION_MODEL=replace-with-a-vision-model
TEXT_MODEL=replace-with-a-text-model
# Upper bound for one model call, retries included.
# LLM_TIMEOUT=5m

# --- Embeddings -------------------------------------------------------------
# EMBEDDING_PROVIDER: local | openai | mistral | gemini | ollama | openai-compatible
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL is required unless the provider is local. The local provider defaults to
# Xenova/multilingual-e5-small and only supports ONNX models of the e5 family.
# EMBEDDING_MODEL=
# The dimension is fixed by the first migration; changing it later is refused at startup.
# EMBEDDING_DIM=384
# Where the local provider keeps its model files; downloaded on first use unless already there.
EMBEDDING_CACHE_DIR=./data/models
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# Upper bound for one embedding request, retries included.
# EMBEDDING_TIMEOUT=1m

# --- Pipeline ---------------------------------------------------------------
# AUTO_APPLY: none | safe | all
# AUTO_APPLY=safe
# CONFIDENCE_THRESHOLD=0.7
# MAX_NEW_TYPES_PER_DAY=5
# SCHEMA_LANGUAGE=en
# WORKERS=2
# A PDF without a text layer costs one vision call per page; a longer one is refused.
# MAX_VISION_PAGES=100

# --- Hindsight (optional) ---------------------------------------------------
# HINDSIGHT_URL=
# HINDSIGHT_BANK=documents
# HINDSIGHT_API_KEY=

# --- Access (required) ------------------------------------------------------
# Comma-separated Bearer tokens for the API and MCP, 16 characters or more each.
# Generate one with: openssl rand -hex 32
API_TOKENS=replace-with-a-long-random-token
# Signs short-lived file URLs, 32 characters or more.
FILE_URL_SECRET=replace-with-at-least-32-random-characters
# Setting a password enables the web UI (plain value or $argon2id$ hash).
# UI_PASSWORD=
# UI_SESSION_TTL=7d
