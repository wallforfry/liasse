# Liasse configuration. Copy to `.env` for local development.
# The schema in packages/core/src/config is the source of truth; a test keeps this file in sync.
# Commented variables show their default (or an example when they have none).
# Only what the process needs before it reads the database is here. The models, their keys,
# the pipeline and Hindsight are settings stored in the database, changed with
# PUT /settings; the server refuses to start while one of their old variables is set.

# --- Server -----------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8080
# The origin clients reach the server at, used to build signed file URLs. Defaults to
# http://HOST:PORT; set it when the server sits behind a reverse proxy or listens on 0.0.0.0.
# PUBLIC_URL=https://liasse.example.com
# The reverse proxies whose X-Forwarded-For (and CF-Connecting-IP, for Cloudflare) give the
# address the sign-in rate limit counts. Comma-separated addresses and CIDR ranges, plus the
# keyword `cloudflare` for Cloudflare's published ranges. List every proxy between the
# client and Liasse, never a range that clients or other containers can connect from: their
# headers are believed.
# Empty: the socket address is the client, and every client behind a proxy counts as it.
# TRUSTED_PROXIES=172.16.0.0/12,cloudflare

# --- Database (required) ----------------------------------------------------
# Postgres 16+ with pgvector 0.8+. This value matches docker-compose.dev.yml.
DATABASE_URL=postgres://liasse:liasse@127.0.0.1:54329/liasse

# --- File storage -----------------------------------------------------------
# STORAGE_DRIVER: fs | s3
# STORAGE_DRIVER=fs
STORAGE_PATH=./data/files
# S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are required when STORAGE_DRIVER=s3.
# S3_BUCKET=liasse
# S3_REGION defaults to us-east-1.
# S3_REGION=eu-west-3
# Set S3_ENDPOINT for any S3-compatible server; objects are then addressed path-style.
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Deadline of one S3 request. An upload gets this plus its size at S3_MIN_UPLOAD_RATE
# (bytes per second), so a large file on a slow link is not cut short.
# S3_REQUEST_TIMEOUT=30s
# S3_MIN_UPLOAD_RATE=65536

# Watched folder; ingestion from disk is disabled when empty. Liasse only reads it. A file
# is read once it held still for two seconds: a writer that pauses longer mid-file gets a
# partial document, so prefer tools that write under a temporary name and rename.
# WATCH_DIR=

# --- Embeddings -------------------------------------------------------------
# The embedder itself is a setting; these two belong to the database and the host.
# The dimension is fixed by the first migration; changing it later is refused at startup.
# EMBEDDING_DIM=384
# Where the local provider keeps its model files; downloaded on first use unless already there.
EMBEDDING_CACHE_DIR=./data/models

# --- Workers ----------------------------------------------------------------
# Jobs processed in parallel by this process.
# WORKERS=2

# --- Access (required) ------------------------------------------------------
# Signs the sessions of the web UI and encrypts the OAuth signing keys, 32 characters or more.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-32-random-characters
# Lifetime of a session of the web UI.
# AUTH_SESSION_TTL=7d
# No account is set here: while none exists, the server prints a setup token to stderr at
# startup, and the web UI on /ui creates the first account with it.
# Signs short-lived file URLs, 32 characters or more.
FILE_URL_SECRET=replace-with-at-least-32-random-characters
