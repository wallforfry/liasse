{
  "name": "@liasse/server",
  "version": "0.0.0",
  "private": true,
  "description": "Liasse application server",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --conditions=@liasse/source --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@liasse/core": "workspace:*",
    "hash-wasm": "4.12.0",
    "hono": "^4.13.18",
    "hono-openapi": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.12.0",
    "drizzle-orm": "^0.45.4"
  }
}
