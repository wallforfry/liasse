{
  "name": "@liasse/server",
  "version": "0.1.0",
  "private": true,
  "description": "Liasse application server",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./runtime": {
      "@liasse/source": "./src/runtime/create-runtime.ts",
      "types": "./dist/runtime/create-runtime.d.ts",
      "default": "./dist/runtime/create-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --conditions=@liasse/source --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@liasse/contract": "workspace:*",
    "@liasse/core": "workspace:*",
    "@liasse/mcp": "workspace:*",
    "@liasse/web": "workspace:*",
    "hono": "^4.13.18",
    "hono-openapi": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@liasse/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@seriousme/openapi-schema-validator": "^2.12.0",
    "drizzle-orm": "^0.45.4"
  }
}
