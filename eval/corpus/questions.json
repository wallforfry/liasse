    {
      "id": "q01",
      "question": "Quel est le montant total de mes factures d'électricité émises en 2025 ?",
      "language": "fr",
      "tools": [
        {
          "tool": "describe_types",
          "arguments": {}
        },
        {
          "tool": "query",
          "arguments": {
            "type": "energy_bill",
            "where": [
              [
                "core.document_date",
                ">=",
                "2025-01-01"
              ],
              [
                "core.document_date",
                "<=",
                "2025-12-31"
              ]
            ],
            "aggregate": {
              "sum": "core.amount.value",
              "count": "*"
            },
            "limit": 50,
            "offset": 0,
            "include_private": false
          }
        }
      ],
      "expected": {
        "documents": {
          "required": [],
          "any_of": [],
          "optional": [
            "energy-bill-2025-01",
            "energy-bill-2025-03",
            "energy-closing-bill-2025-04",
            "energy-bill-2025-06",
            "energy-bill-2025-08",
            "energy-bill-2025-10"
          ],
          "forbidden": [
            "energy-bill-2024-11"
          ],
          "exhaustive": false
        },
        "amounts": [
          {
            "key": "total",
            "label": "total of the electricity bills dated 2025",
            "value": {
              "value": 597.15,
              "currency": "EUR"
            },
            "tolerance": 0.01
          }
        ],
        "dates": [],
        "counts": [
          {
            "key": "bills",
            "label": "electricity bills dated 2025",
            "value": 6
          }
        ],
        "entities": {
          "required": [],
          "exhaustive": false
        },
        "verdict": null
      },
      "rationale": "Six bills are dated 2025, from two suppliers. The June bill exists twice as the same bytes: counted twice, the total becomes 686.05. The 2024 bill and the internet bills stay out."
