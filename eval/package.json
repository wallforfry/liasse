{
  "name": "@liasse/eval",
  "version": "0.2.0",
  "private": true,
  "description": "Liasse public evaluation set: a synthetic corpus, its ground truth, reference questions and scoring",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallforfry/liasse.git",
    "directory": "eval"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.22.3 || >=26.5.1"
  },
  "exports": {
    "./corpus": "./src/corpus.ts",
    "./schema": "./src/schema/index.ts",
    "./score": "./src/score/index.ts"
  },
  "scripts": {
    "calibrate": "node --env-file-if-exists=../.env --conditions=@liasse/source --experimental-strip-types src/calibrate/cli.ts",
    "compare": "node --conditions=@liasse/source --experimental-strip-types src/harness/compare-cli.ts",
    "generate": "node --conditions=@liasse/source --experimental-strip-types src/generate/cli.ts",
    "harness": "node --env-file-if-exists=../.env --conditions=@liasse/source --experimental-strip-types src/harness/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@liasse/contract": "workspace:*",
    "@liasse/core": "workspace:*",
    "@liasse/sdk": "workspace:*",
    "@liasse/server": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/heic-decode": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "heic-decode": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "zod": "^4.6.7"
  }
}
