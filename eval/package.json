{
  "name": "@liasse/eval",
  "version": "0.0.0",
  "private": true,
  "description": "Liasse public evaluation set: a synthetic corpus, its ground truth, reference questions and scoring",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallforfry/liasse.git",
    "directory": "eval"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./corpus": "./src/corpus.ts",
