{
  "name": "liasse",
  "version": "0.0.0",
  "private": true,
  "description": "Lightweight, agent-first document management",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "volta": {
    "node": "26.13.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.22.3 || >=26.5.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "db:clean-test": "pnpm --filter @liasse/core db:clean-test",
    "db:down": "docker compose -f docker-compose.dev.yml --profile paradedb down",
    "db:generate": "pnpm -r db:generate",
    "db:migrate": "pnpm -r db:migrate",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:up:paradedb": "docker compose -f docker-compose.dev.yml --profile paradedb up -d --wait paradedb",
    "eval:calibrate": "pnpm --filter @liasse/eval calibrate",
    "eval:compare": "pnpm --filter @liasse/eval compare",
    "eval:run": "pnpm --filter @liasse/eval harness",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "test": "vitest run",
    "test:models": "vitest run --config packages/core/vitest.models.config.ts",
    "test:paradedb": "vitest run --config vitest.paradedb.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
