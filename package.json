{
  "name": "liasse",
  "version": "0.0.0",
  "private": true,
  "description": "Lightweight, agent-first document management",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "db:clean-test": "pnpm --filter @liasse/core db:clean-test",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "pnpm -r db:generate",
    "db:migrate": "pnpm -r db:migrate",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "test": "vitest run",
    "test:models": "vitest run --config packages/core/vitest.models.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
