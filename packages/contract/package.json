{
  "name": "@liasse/contract",
  "version": "0.0.0",
  "description": "Liasse contract: the Zod schemas and types of every request and answer, and the domain they use",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallforfry/liasse.git",
    "directory": "packages/contract"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@liasse/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "@liasse/source": "./src/domain/index.ts",
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./entities": {
      "@liasse/source": "./src/entities/index.ts",
      "types": "./dist/entities/index.d.ts",
      "default": "./dist/entities/index.js"
    },
    "./query": {
      "@liasse/source": "./src/query/index.ts",
      "types": "./dist/query/index.d.ts",
      "default": "./dist/query/index.js"
    },
    "./registry": {
      "@liasse/source": "./src/registry/index.ts",
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    },
    "./search": {
      "@liasse/source": "./src/search/index.ts",
      "types": "./dist/search/index.d.ts",
      "default": "./dist/search/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
