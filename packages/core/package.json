{
  "name": "@liasse/core",
  "version": "0.0.0",
  "description": "Liasse core: configuration, database, domain and model ports",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallforfry/liasse.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    "./config": {
      "@liasse/source": "./src/config/index.ts",
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./db": {
      "@liasse/source": "./src/db/index.ts",
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./domain": {
      "@liasse/source": "./src/domain/index.ts",
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./embeddings": {
      "@liasse/source": "./src/embeddings/index.ts",
      "types": "./dist/embeddings/index.d.ts",
      "default": "./dist/embeddings/index.js"
    },
    "./ingest": {
      "@liasse/source": "./src/ingest/index.ts",
      "types": "./dist/ingest/index.d.ts",
      "default": "./dist/ingest/index.js"
    },
    "./jobs": {
      "@liasse/source": "./src/jobs/index.ts",
      "types": "./dist/jobs/index.d.ts",
      "default": "./dist/jobs/index.js"
    },
    "./models": {
      "@liasse/source": "./src/models/index.ts",
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models/index.js"
    },
    "./prompt": {
      "@liasse/source": "./src/prompt/index.ts",
      "types": "./dist/prompt/index.d.ts",
      "default": "./dist/prompt/index.js"
    },
    "./query": {
      "@liasse/source": "./src/query/index.ts",
      "types": "./dist/query/index.d.ts",
      "default": "./dist/query/index.js"
    },
    "./registry": {
      "@liasse/source": "./src/registry/index.ts",
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    },
    "./search": {
      "@liasse/source": "./src/search/index.ts",
      "types": "./dist/search/index.d.ts",
      "default": "./dist/search/index.js"
    },
    "./storage": {
      "@liasse/source": "./src/storage/index.ts",
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./testing": {
      "@liasse/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./text": {
      "@liasse/source": "./src/text/index.ts",
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --experimental-strip-types src/db/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/mistral": "^4.0.87",
    "@ai-sdk/openai": "^4.0.118",
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@huggingface/transformers": "^4.3.2",
    "ai": "^7.0.173",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "heic-decode": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "pdfjs-dist": "^6.5.438",
    "postal-mime": "^4.2.1",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/heic-decode": "^2.0.1",
    "drizzle-kit": "^0.31.11"
  }
}
