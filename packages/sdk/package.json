{
  "name": "@liasse/sdk",
  "version": "0.0.0",
  "description": "Liasse TypeScript client",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallforfry/liasse.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
